+/** y at pixel x of a PINNED line, exact over the loaded chart bars. A line
+ * is straight in HTF bars, but the chart's bars are not evenly spaced in HTF
+ * time (a night or a weekend is one candle gap on the chart and many hours of
+ * HTF progress), so on the chart the same line is a polyline with a small
+ * kink at every gap. Crossings and touches are decided per candle against
+ * that exact value, and a straight pixel segment can sit a few tenths off it,
+ * which was enough to float a × in the gap under a candle whose close had cut
+ * the line by a cent. Inside [0, lastChartIdx] the value is the projection at
+ * the bar's own line-space index; past either end it follows the straight
+ * (x0,y0)-(x1,y1) segment (see pinnedEndY), shifted so it meets the exact
+ * curve at the edge. */
+export function pinnedLineY(
+  line: TrendLine,
+  toLine: (idx: number) => number,
+  idxAtX: (x: number) => number,
+  xAtIdx: (idx: number) => number,
+  yAt: (price: number) => number,
+  lastChartIdx: number,
+  x0: number,
+  y0: number,
+  x1: number,
+  y1: number,
+): (x: number) => number {
+  const straight = (x: number): number =>
+    x1 === x0 ? y0 : y0 + ((y1 - y0) * (x - x0)) / (x1 - x0);
+  const exact = (idx: number): number => yAt(projectAt(line, toLine(idx)));
+  if (lastChartIdx < 0) return straight;
+  const xFirst = xAtIdx(0);
+  const xLast = xAtIdx(lastChartIdx);
+  const offFirst = exact(0) - straight(xFirst);
+  const offLast = exact(lastChartIdx) - straight(xLast);
+  return (x: number): number => {
+    if (x < xFirst) return straight(x) + offFirst;
+    if (x > xLast) return straight(x) + offLast;
+    return exact(idxAtX(x));
+  };
+}
