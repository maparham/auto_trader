+
+describe("pinnedLineY", () => {
+  // Rising line, +10 per HTF bar from 100. Two chart bars per HTF bar over
+  // the loaded range 0..8 (10px per chart bar), except a gap: chart bar 5
+  // sits a whole HTF bar after chart bar 4, the way a weekend does.
+  const rising: TrendLine = {
+    i1: 0, p1: 100, k1: "low", i2: 1, p2: 110, k2: "low",
+    touches: 2, touchIdxs: [0, 1], touchKinds: ["low", "low"], lastTouchIdx: 1,
+    crossings: 0, crossIdxs: [], lastSign: 1,
+    maxTouchGap: 1, minTouchGap: 1, maxTouchIdx: 1,
+  };
+  const toLine = (c: number) => (c <= 4 ? c / 2 : c < 5 ? 2 + (c - 4) : c / 2 + 0.5);
+  const xAtIdx = (c: number) => c * 10;
+  const idxAtX = (x: number) => x / 10;
+  const yAt = (p: number) => p;
+  // The straight segment reads 140 at x=80 where the exact curve is 145.
+  const y = pinnedLineY(rising, toLine, idxAtX, xAtIdx, yAt, 8, 0, 100, 80, 140);
+
+  it("is the exact projection at every loaded bar, gap included", () => {
+    expect(y(40)).toBe(120); // bar 4 -> line 2
+    expect(y(50)).toBe(130); // bar 5 -> line 3: the weekend kink
+    expect(y(45)).toBe(125); // between them
+    expect(y(80)).toBe(145);
+  });
+
+  it("continues past the loaded edges along the straight segment, without a step", () => {
+    // Lifted by the 5 the straight segment is short at the right edge; the
+    // left edge agrees with the curve, so nothing shifts there.
+    expect(y(100)).toBeCloseTo(140 + (40 / 80) * 20 + 5);
+    expect(y(-20)).toBeCloseTo(100 - (40 / 80) * 20);
+  });
+
+  it("is the straight segment with nothing loaded", () => {
+    const empty = pinnedLineY(rising, toLine, idxAtX, xAtIdx, yAt, -1, 0, 100, 80, 140);
+    expect(empty(40)).toBe(120);
+  });
+});
