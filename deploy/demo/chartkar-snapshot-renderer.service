# Standalone Playwright + Chromium renderer for Telegram alert chart
# snapshots, in its OWN cgroup, fully isolated from auto-trader-demo.
#
# Replaces chartkar-snapshot-browser.service (removed 2026-10-20), which
# isolated only Chromium while the Playwright driver stayed inside the API.
# On 2026-10-20 that driver died under memory pressure and the whole API
# stopped answering. This unit owns Playwright end to end and starts Chromium
# per render (see backend/auto_trader/snapshot_renderer/app.py), so it idles
# at the bare Python process. No swap: a heavy render is OOM-killed here
# rather than pushing the API into swap; systemd restarts it.
#
# MALLOC_ARENA_MAX=2 caps glibc malloc arenas (otherwise each thread grows
# its own heap). auto-trader-demo has the same setting in a drop-in that
# exists only on the box (auto-trader-demo.service.d/malloc.conf).
#
# Installed by scripts/deploy-demo.sh.
[Unit]
Description=Chartkar snapshot renderer (Playwright + Chromium, HTTP on 127.0.0.1:9223)
After=network.target

[Service]
User=ec2-user
WorkingDirectory=/opt/auto-trader/backend
EnvironmentFile=/etc/auto-trader/demo.env
Environment=MALLOC_ARENA_MAX=2
ExecStart=/opt/auto-trader/venv/bin/python3 -m auto_trader.snapshot_renderer
Restart=always
RestartSec=3
MemoryHigh=450M
MemoryMax=600M
MemorySwapMax=0

[Install]
WantedBy=multi-user.target
