{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Chartkar",
  "version": "0.1.0",
  "identifier": "com.mahan.autotrader.shell",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Chartkar",
        "url": "splash.html",
        "width": 1440,
        "height": 900,
        "resizable": true,
        "visible": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "icon": [
      "icons/icon.icns"
    ]
  }
}
